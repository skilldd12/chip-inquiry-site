# ============================================================================
# 轴点电子（占位名）B2B 元器件询价站 — 环境变量样例
# 复制为 .env.local（开发）或写入部署平台的环境变量（生产）。
# 不要把真实的 .env.local 提交到版本库。
# ============================================================================

# ---------------------------------------------------------------------------
# 1. 站点
# ---------------------------------------------------------------------------
# 生产环境必须改成正式域名，用于 canonical / hreflang / sitemap / OG 图绝对地址
NEXT_PUBLIC_SITE_URL=http://localhost:4310

# ---------------------------------------------------------------------------
# 2. 后台管理员（首次启动时若 admin_users 为空则按此创建）
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=运营管理员
# 生产环境必须改成强密码（≥12 位，含大小写数字符号）；开发默认值仅用于本机
ADMIN_PASSWORD=change-me-before-launch

# 会话 cookie 的 HMAC 密钥：生产环境必填且 ≥24 字符
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# 可选：IP 哈希专用盐（≥16 字符），用于限流与去重键。
# 不填时：优先复用 ADMIN_SESSION_SECRET；若两者都没有，则退化为固定盐并打印一次告警
# （这样后台密钥缺失不会导致公开询价接口 500）。
IP_HASH_SECRET=

# ---------------------------------------------------------------------------
# 3. 数据与私有附件存储
# ---------------------------------------------------------------------------
# SQLite 数据目录（默认 ./data）。相对路径按项目根目录解析。
DATA_DIR=./data
# 可单独指定数据库文件；留空则使用 ${DATA_DIR}/app.db
DATABASE_FILE=

# ---------------------------------------------------------------------------
# 4. 询价通知（可选；未配置时不会发送，也不会伪造"已发送"）
# ---------------------------------------------------------------------------
# 企业微信/飞书/Slack 的 incoming webhook 均可，接收 JSON POST
NOTIFY_WEBHOOK_URL=
# 可选：以 Authorization: Bearer <token> 形式发送
NOTIFY_WEBHOOK_TOKEN=

# ---------------------------------------------------------------------------
# 5. 仅本地验证脚本使用（服务端运行时不读取）
# ---------------------------------------------------------------------------
# 截图/性能脚本使用的 Chrome 可执行文件路径
CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
